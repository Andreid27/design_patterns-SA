		{
			"name": "Undo Last Action",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/orders/undo",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"orders",
						"undo"
					]
				},
				"description": "**Design Pattern: Command Pattern**\n\nThis endpoint demonstrates the Command pattern's undo functionality. It reverses the last order operation (create or cancel).\n\nThe Command pattern allows storing command history and implementing undo/redo operations by keeping track of executed commands."
			},
